{
  "name": "@dgrammatiko/formally",
  "version": "0.1.0",
  "description": "Form validation leveraging the platform",
  "main": "src/formally.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node build.js",
    "lint": "oxlint src",
    "format": "oxfmt --write src",
    "test": "vitest",
    "autoprefix": "npx browserslist@latest --update-db",
    "coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dgrammatiko/formally.git"
  },
  "keywords": [
    "form",
    "validation",
    "bootstrap",
    "foundation",
    "uikit",
    "bulma",
    "vanilla",
    "javascript"
  ],
  "author": "Dimitrios Grammatikogiannis",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dgrammatiko/formally/issues"
  },
  "homepage": "https://github.com/dgrammatiko/formally#readme",
  "devDependencies": {
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "puppeteer": "25.17.0",
    "rolldown": "^1.3.1",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "punycode": "^2.3.1"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "puppeteer@25.17.0": true
  }
}
